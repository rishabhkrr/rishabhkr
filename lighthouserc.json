{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": ["http://localhost/", "http://localhost/insights/sql-for-business-analysts.html", "http://localhost/work/erp-wms.html"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:performance": ["warn", { "minScore": 0.8, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
